  }
  payment_adjustments {
    bigint id PK
    bigint payment_id FK
    bigint correction_request_id FK
    enum type
    paise delta_paise
    bigint created_by FK
    string reason
  }
  payment_allocations {
    bigint id PK
    bigint payment_id FK
    bigint installment_id FK
    paise amount_paise
    bigint adjustment_id FK
  }
  razorpay_events {
    bigint id PK
    string event_id UK
    string event_type
    bigint payment_id FK
    json payload
    enum status
    datetime processed_at
    string error
  }
