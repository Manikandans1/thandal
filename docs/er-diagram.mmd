    paise amount_paise
    paise paid_paise
    enum status
    datetime paid_at
  }
  disbursements {
    bigint id PK
    bigint chit_id FK
    enum method
    paise amount_paise
    enum status
    date disbursed_on
    string reference
    string note
    bigint recorded_by FK
  }
  payments {
    bigint id PK
